# =====================================
# FRONTEND ENVIRONMENT VARIABLES
# =====================================

# QR Code Encryption Key (use a strong, unique secret key)
# MUST match REACT_APP_QR_ENCRYPTION_KEY used by the other apps
# if the same login QR codes are shared across apps.
REACT_APP_QR_ENCRYPTION_KEY=your_secret_encryption_key_here

# =====================================
# SERVERLESS API ENVIRONMENT VARIABLES
# (Required for Vercel Deployment & Password Resets)
# =====================================

# Gmail SMTP Credentials for Sending Verification Codes
# Get App Password from: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Firebase Admin SDK Credentials (Required for resetting passwords in Firebase Authentication)
# Get these from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=academia-de-san-jose
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@academia-de-san-jose.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----\n"